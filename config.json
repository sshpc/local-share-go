{
  // 监听地址。写 "0.0.0.0:8081" 表示所有网卡、固定 8081 端口。
  // 也可以只写端口号，如 "8081"，等价于 "0.0.0.0:8081"。
  //
  // 【强制指定端口】把下面的 auto_port 设为 false，
  // 端口被占用时程序会直接报错退出，而不会自动换端口。
  "server_addr": "0.0.0.0:8081",

  // 文件存储目录。相对路径相对于程序的工作目录。
  "upload_dir": "./uploads",

  // 对外访问地址前缀。
  // 留空（推荐）：程序启动时自动探测本机局域网 IP，并在你从 localhost
  // 打开页面时自动替换成局域网地址，手机扫码即可直接下载。
  //
  // 【强制指定】需要固定域名或反向代理时填写，例如：
  //   "public_base_url": "https://share.example.com"
  // 填写后程序不再自动推导，链接一律使用这个值。
  "public_base_url": "",

  // 端口被占用时是否自动顺延到下一个可用端口（8081 → 8082 → 8083 …）。
  // true：自动切换，启动日志会打印实际使用的端口；
  // false：强制使用 server_addr 里的端口，占用则启动失败。
  "auto_port": true,

  // auto_port 为 true 时，最多向后尝试多少个端口。
  "port_attempts": 20,

  // 启动后是否自动用默认浏览器打开首页。
  // true：双击程序即自动打开 http://localhost:<端口>；
  // false：只打印地址，需要自己打开（适合做后台服务）。
  "open_browser": true
}
